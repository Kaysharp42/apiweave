{
  "name": "apiweave",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "description": "APIWeave local-first API testing desktop app",
  "author": "Kaysharp42 <kaysharp42@users.noreply.github.com>",
  "homepage": "https://github.com/Kaysharp42/apiweave",
  "main": "dist/desktop/main.cjs",
  "bin": {
    "apiweave": "dist/cli/apiweave.cjs"
  },
  "scripts": {
    "setup": "npm install",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "npm run build:app && electron-builder",
    "build:app": "npm run build:renderer && npm run build:electron && npm run build:cli",
    "build:renderer": "vite build",
    "build:electron": "node esbuild.config.cjs",
    "build:cli": "node esbuild.config.cjs --cli",
    "cli": "npm run --silent build:cli && node dist/cli/apiweave.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:renderer": "vitest run src",
    "test:desktop": "vitest run core electron shared",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:desktop",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.desktop.json",
    "lint": "eslint src core electron shared",
    "lint:renderer": "eslint src",
    "format": "prettier --write \"{src,core,electron,shared}/**/*.{ts,tsx,json,css,md}\"",
    "audit:types": "node scripts/audit-types.mjs",
    "doctor": "npx react-doctor@latest",
    "qa:ui": "playwright test",
    "capture:media": "playwright test --config=tools/marketing-capture/playwright.config.ts capture.spec.ts",
    "capture:demo": "playwright test --config=tools/marketing-capture/playwright.config.ts demo.spec.ts",
    "capture:encode": "node tools/marketing-capture/encode.mjs",
    "capture:validate": "node tools/marketing-capture/validate.mjs",
    "capture:all": "npm run capture:media && npm run capture:demo && npm run capture:encode && npm run capture:validate",
    "parity": "node core/runner/harness/run-parity.mjs",
    "parity:capture": "node core/runner/harness/run-parity.mjs --capture",
    "mcp:baseline": "tsx --tsconfig tsconfig.desktop.json core/mcp/harness/run-baseline.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "libsodium-wrappers": "^0.8.4",
    "node-pty": "^1.2.0-beta.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apiweave/proto": "https://github.com/Kaysharp42/apiweave-proto/archive/refs/tags/v0.9.1.tar.gz",
    "@bufbuild/protobuf": "^2.16.0",
    "@cfworker/json-schema": "^4.1.1",
    "@dagrejs/dagre": "^3.1.1",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.9",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.12.0",
    "allotment": "^1.20.6",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.10.38",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "daisyui": "^5.7.50",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "fallow": "^2.98.0",
    "jose": "6.2.12",
    "jsdom": "^25.0.1",
    "json-edit-react": "^1.30.1",
    "lucide-react": "^0.548.0",
    "monaco-editor": "0.57.0",
    "nock": "^14.0.16",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^18.2.0",
    "react-doctor": "^0.9.18",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^3.3.0",
    "tough-cookie": "^5.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "undici": "^7.16.0",
    "vite": "^5.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.kaysharp.apiweave",
    "productName": "APIWeave",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Kaysharp42/apiweave/releases/latest/download",
        "useMultipleRangeRequest": false,
        "channel": "latest"
      },
      {
        "provider": "github",
        "owner": "Kaysharp42",
        "repo": "apiweave"
      }
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "dist/desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/renderer",
        "to": "renderer"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "dist/desktop/script-worker.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "libxtst",
        "at-spi2-core"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  },
  "allowScripts": {
    "electron@44.4.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
