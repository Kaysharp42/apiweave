# npm 12 defaults `allow-remote` to "none", which blocks the @apiweave/proto
# devDependency below — it's a tarball fetched straight from a GitHub release
# archive, not the npm registry:
#   "@apiweave/proto": "https://github.com/Kaysharp42/apiweave-proto/archive/refs/tags/v0.8.0.tar.gz"
# "root" allows exactly that (a remote-tarball dependency declared directly in
# this project's own package.json) without opening the door to a transitive
# dependency somewhere in node_modules doing the same thing.
allow-remote=root
